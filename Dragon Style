_G.voicepack = "Kiryu"
local voice = RPS.Voices:FindFirstChild(_G.voicepack)
local character = player.Character

local function playSound(sound)
    local clone = Instance.new("Sound")
    clone.Parent = character.Head
    clone.SoundId = sound.Value
    clone.Volume = 0.35
    clone:Play()
    clone.Ended:Connect(function()
        game:GetService("Debris"):AddItem(clone)
    end)
end

local function fetchRandom(instance)
    local children = instance:GetChildren()
    return children[math.random(1, #children)]
end

character.ChildAdded:Connect(function(child)
    if child.Name == "Hitstunned" then
        playSound(fetchRandom(voice.Pain))
    end
    if child.Name == "Ragdolled" then
        playSound(fetchRandom(voice.Knockdown))
    end
    if child.Name == "Stunned" then
        playSound(fetchRandom(voice.Stun))
    end
end)

status.CurrentMove.Changed:Connect(function()
    if string.match(status.CurrentMove.Value.Name, "Attack") then
        playSound(fetchRandom(voice.LightAttack))
    end
end)

-- Aura Color
local HarveyColor = Color3.fromRGB(255, 0, 0)
local HarveySequence = ColorSequence.new({
    ColorSequenceKeypoint.new(0, HarveyColor),
    ColorSequenceKeypoint.new(1, HarveyColor)
})

local function updateAura()
    if status.Style.Value == "Brawler" then
        local char = player.Character
        local hrp = char.HumanoidRootPart
        hrp.Fire_Main.Color = HarveySequence
        hrp.Fire_Secondary.Color = HarveySequence
        hrp.Lines1.Color = HarveySequence
        hrp.Lines2.Color = HarveySequence
        hrp.Sparks.Color = HarveySequence
        char.UpperTorso["r2f_aura_burst"].Lines1.Color = HarveySequence
        char.UpperTorso["r2f_aura_burst"].Lines2.Color = HarveySequence
        char.UpperTorso["r2f_aura_burst"].Flare.Color = HarveySequence
        char.UpperTorso["r2f_aura_burst"].Smoke.Color = HarveySequence
        char.UpperTorso.Evading.Color = HarveySequence
    end
end

game:GetService("RunService").RenderStepped:Connect(updateAura)

-- Notifications
local notifyevent
for i, v in pairs(pgui:GetChildren()) do
    if v:IsA("BindableEvent") then
        notifyevent = v
    end
end

local function sendNotification(text, color)
    if not color then color = Color3.new(1, 1, 1) end
    pgui.NotifyUI.Awards.ChildAdded:Once(function(c)
        if c.Text == text then
            c.TextColor3 = color
        end
    end)
    notifyevent:Fire(text)
end

-- Fill Heat with F key
local function fillHeat()
    local Event = RPS.Events.ME
    for i = 1, 6 do
        Event:FireServer({[1] = "heat", [2] = moves.Taunt})
    end
end

game:GetService("UserInputService").InputBegan:Connect(function(key)
    if game:GetService("UserInputService"):GetFocusedTextBox() == nil then
        if key.KeyCode == Enum.KeyCode.F then
            fillHeat()
        end
    end
end)

