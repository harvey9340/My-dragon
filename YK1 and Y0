local function updateVisuals()
    if status.Style.Value ~= "Brawler" then
        -- not in Dragon style — restore defaults
        char.UpperTorso["r2f_aura_burst"].Flare.Enabled  = false
        char.UpperTorso["r2f_aura_burst"].Lines1.Enabled = false
        if stance.IsPlaying then stance:Stop() end
        root.Fire_Main.Rate      = 80
        root.Fire_Secondary.Rate = 50
        root.Lines1.Rate         = 20
        root.Lines2.Rate         = 20
        main.Heat.Fill.ImageColor3       = Color3.fromRGB(40, 150, 250)
        main.Heat.Fill2.ImageColor3      = Color3.fromRGB(70, 250, 250)
        main.Heat.ClimaxFill.ImageColor3 = Color3.fromRGB(180, 0, 0)
        main.Heat.ClimaxFill2.ImageColor3= Color3.fromRGB(250, 60, 100)
        return
    end

    -- Style name & XP bar
    game.ReplicatedStorage.Styles.Brawler.VisualName.Value = StyleName
    game.ReplicatedStorage.Styles.Brawler.Color.Value      = StyleColor
    main.XP.Fill.ImageColor3 = StyleColor

    -- Aura particles
    root.Fire_Main.Color      = StyleSequence
    root.Fire_Secondary.Color = StyleSequence
    root.Lines1.Color         = StyleSequence
    root.Lines2.Color         = StyleSequence
    root.Sparks.Color         = StyleSequence

    -- Particle rate scales with heat
    local heat = status.Heat.Value
    root.Fire_Main.Rate      = heat >= 100 and 115 or heat >= 75 and 88 or 80
    root.Fire_Secondary.Rate = heat >= 100 and 92  or heat >= 75 and 82 or 70
    root.Lines1.Rate         = heat >= 100 and 60  or heat >= 75 and 40 or 20
    root.Lines2.Rate         = heat >= 100 and 60  or heat >= 75 and 40 or 20

    -- Burst aura (max heat only, not during heat action)
    char.UpperTorso["r2f_aura_burst"].Lines1.Color   = StyleSequence
    char.UpperTorso["r2f_aura_burst"].Lines2.Color   = StyleSequence
    char.UpperTorso["r2f_aura_burst"].Flare.Color    = StyleSequence
    char.UpperTorso["r2f_aura_burst"].Smoke.Color    = StyleSequence
