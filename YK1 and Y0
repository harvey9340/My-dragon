local hasSetup = false
local function setupOnce()
    if hasSetup then return end
    hasSetup = true

    notify("setting up Dragon Style...", StyleColor)

    -- Style tab name
    StyleSequence = ColorSequence.new({
        ColorSequenceKeypoint.new(0, StyleColor),
        ColorSequenceKeypoint.new(1, StyleColor),
    })
    abil.Tabs.Tabs.Brawler.Filled.Title.Text = StyleName
    status.Stats.Kills_Brawler.Visual.Value  = "Enemies defeated in " .. StyleName .. " style"

    -- Apply the chosen moveset
    if Moveset == "Y0" then
        applyY0Moves()
    elseif Moveset == "YK1" then
        applyYK1Moves()
    end

    -- Mod credit watermark
    menu.Bars.Mobile_Title.Text    = StyleName .. " Dragon Style Mod"
    menu.Bars.Mobile_Title.Visible = true

    -- Heat bar shimmer indicator (lights up at 50+ heat)
    if not main.Heat:FindFirstChild("HeatShimmer") then
        local shimmer = main.Heat.Fill2:Clone()
        shimmer.Name             = "HeatShimmer"
        shimmer.Parent           = main.Heat
        shimmer.ImageColor3      = Color3.fromRGB(255, 255, 255)
        shimmer.ImageTransparency = 1
        shimmer.Visible          = false
        main.Heat.Fill2.Changed:Connect(function()
            shimmer.Size = main.Heat.Fill2.Size
        end)
        TweenService:Create(shimmer,
            TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, math.huge, true),
            { ImageTransparency = 0.4 }
        ):Play()
        local function refreshShimmer()
            shimmer.Visible = status.Heat.Value >= 50
        end
        status.Heat.Changed:Connect(refreshShimmer)
        refreshShimmer()
    end

    -- Climax heat shimmer (lights up at 100 heat)
    if not main.Heat:FindFirstChild("ClimaxShimmer") then
        local cshimmer = main.Heat.ClimaxFill2:Clone()
        cshimmer.Name              = "ClimaxShimmer"
        cshimmer.Parent            = main.Heat
        cshimmer.ImageColor3       = Color3.fromRGB(255, 255, 255)
        cshimmer.ImageTransparency = 1
        cshimmer.Visible           = false
        main.Heat.ClimaxFill2.Changed:Connect(function()
            cshimmer.Size = main.Heat.ClimaxFill2.Size
        end)
        TweenService:Create(cshimmer,
            TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, math.huge, true),
            { ImageTransparency = 0.4 }
        ):Play()
        local function refreshClimax()
            cshimmer.Visible = status.Heat.Value >= 100
        end
        status.Heat.Changed:Connect(refreshClimax)
        refreshClimax()
    end

    -- Reload client to apply move swaps
    local savedCFrame = char.LowerTorso.CFrame
    notify("reloading to apply moves...", StyleColor)
    interf.Client.Disabled = true
    task.wait()
    interf.Client.Disabled = false
    task.wait(0.1)
    char.LowerTorso.CFrame = savedCFrame

    notify(StyleName .. " Dragon Style loaded!", StyleColor)
end

