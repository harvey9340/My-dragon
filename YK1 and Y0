-- ══════════════════════════════════
--   VOICE MOD
--   Y0  = Kiryu Yakuza 0 voice
--   YK1 = Kiryu Kiwami 1 voice
-- ══════════════════════════════════

if VoiceMod then
    _G.voicepack = "Kiryu"
    _G.voice     = RPS.Voices:FindFirstChild(_G.voicepack)

    if _G.voice then
        sendNotif("VoiceMod loaded: " .. _G.voice.Name, StyleColor)

        local function playSound(sound)
            local clone = Instance.new("Sound")
            clone.Parent  = char.Head
            clone.Name    = sound.Name
            clone.SoundId = sound.Value
            clone.Volume  = 0.35
            clone:Play()
            clone.Ended:Connect(function()
                Debris:AddItem(clone)
            end)
        end

        local function getRandom(folder)
            local list = folder:GetChildren()
            return list[math.random(1, #list)]
        end

        -- Battle start voice line
        plr.ChildAdded:Connect(function(child)
            if child.Name == "InBattle" then
                playSound(getRandom(_G.voice.BattleStart))
            end
        end)

        -- Hit, knockdown, death, stun voice lines
        local hitCD = false
        char.ChildAdded:Connect(function(child)

            -- Heat action voice line
            if child.Name == "Heated" then
                local heating = child:WaitForChild("Heating", 0.5)
                if heating and heating.Value ~= char then
                    if not child:FindFirstChild("Throwing") then
                        playSound(getRandom(_G.voice.HeatAction))
                    end
                end
            end

            -- Pain voice line with cooldown
            if child.Name == "Hitstunned"
                and not char:FindFirstChild("Ragdolled")
            then
                if not hitCD then
                    hitCD = true
                    playSound(getRandom(_G.voice.Pain))
                    delay(2, function() hitCD = false end)
                end
            end

            if child.Name == "Ragdolled" then
                playSound(getRandom(_G.voice.Knockdown))
            end

            if child.Name == "ImaDea" then
                playSound(getRandom(_G.voice.Death))
            end

            if child.Name == "Stunned" then
                playSound(getRandom(_G.voice.Stun))
            end
        end)

        -- Recovery voice line
        char.ChildRemoved:Connect(function(child)
            if child.Name == "Ragdolled" then
                task.wait(0.1)
                if not string.match(status.CurrentMove.Value.Name, "Getup") then
                    playSound(getRandom(_G.voice.Recover))
                end
            end
        end)

        -- Silence default taunt and replace with voice pack
        local silentTaunt = RPS.Sounds:FindFirstChild("Laugh"):Clone()
        silentTaunt.Parent = RPS.Sounds
        silentTaunt.Name   = "SilentTaunt"
        silentTaunt.Volume.Value = 0
        moves.Taunt.Sound.Value     = "SilentTaunt"
        moves.RushTaunt.Sound.Value = "SilentTaunt"

        status.Taunting.Changed:Connect(function()
            if status.Taunting.Value == true
                and status.CurrentMove.Value.Name ~= "BeastTaunt"
            then
                playSound(getRandom(_G.voice.Taunt))
            end
        end)

        -- Light attack voice line
        local lightCD = false
        status.CurrentMove.Changed:Connect(function()
            local name = status.CurrentMove.Value.Name
            if string.match(name, "Attack") or string.match(name, "Punch") then
                if not lightCD then
                    lightCD = true
                    playSound(getRandom(_G.voice.LightAttack))
                    delay(0.35, function() lightCD = false end)
                end
            elseif not string.match(name, "Taunt")
                and not string.match(name, "Grab")
            then
                playSound(getRandom(_G.voice.HeavyAttack))
            end
        end)

        -- Dodge voice line
        local dodgeCD = false
        status.FFC.Evading.Changed:Connect(function()
            if status.FFC.Evading.Value == true
                and char:FindFirstChild("BeingHacked")
                and not dodgeCD
            then
                dodgeCD = true
                playSound(getRandom(_G.voice.Dodge))
                delay(10, function() dodgeCD = false end)
            end
        end)

        -- Mute game knockouts so voice plays cleanly
        char.HumanoidRootPart.ChildAdded:Connect(function(child)
            if child.Name == "KnockOut" or child.Name == "KnockOutRare" then
                child.Volume = 0
            end
        end)

    else
        sendNotif("VoiceMod: voice pack not found", Color3.fromRGB(200, 0, 0))
    end
end

-- ══════════════════════════════════
--   MORPH MOD
--   Y0  = base Kiryu look
--   YK1 = Kiwami Kiryu look
-- ══════════════════════════════════

if MorphMod then
    _G.Morph = Moveset == "Y0" and "Kiryu" or "Kiryu Kiwami"

    local morphLock = RPS:FindFirstChild("CharacterMorphMod")
    if not morphLock then
        local v = Instance.new("BoolValue")
        v.Name   = "CharacterMorphMod"
        v.Value  = true
        v.Parent = RPS
    end

    -- Watch for model changes and reapply morph
    local function applyMorph()
        local morphFolder = RPS:FindFirstChild("CharacterMorphs")
        if morphFolder then
            local target = morphFolder:FindFirstChild(_G.Morph)
            if target then
                for _, part in pairs(target:GetChildren()) do
                    local charPart = char:FindFirstChild(part.Name)
                    if charPart then
                        for _, mesh in pairs(part:GetChildren()) do
                            if mesh:IsA("SpecialMesh") then
                                local existing = charPart:FindFirstChildOfClass("SpecialMesh")
                                if existing then
                                    existing.MeshId    = mesh.MeshId
                                    existing.TextureId = mesh.TextureId
                                    existing.Scale     = mesh.Scale
                                end
                            end
                        end
                        if part:IsA("BasePart") then
                            charPart.Color = part.Color
                        end
                    end
                end
            end
        end
    end

    applyMorph()

    -- Reapply morph on character reload
    char.DescendantAdded:Connect(function(desc)
        if desc:IsA("SpecialMesh") then
            applyMorph()
        end
    end)

    -- CustomMorphSkin applies a skin color override on top
    if CustomMorphSkin then
        local function applySkin()
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Color = StyleColor
                end
            end
        end
        applySkin()
        sendNotif("CustomMorphSkin applied over " .. _G.Morph, StyleColor)
    else
        sendNotif("MorphMod active | " .. _G.Morph, StyleColor)
    end
end

