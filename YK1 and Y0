-- ══════════════════════════════════

local deathFilter        = Instance.new("ColorCorrectionEffect")
deathFilter.Name         = "DragonDeathFilter"
deathFilter.Parent       = workspace.CurrentCamera

local function playDeathFilter()
    TweenService:Create(deathFilter,
        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
        { TintColor = Color3.fromRGB(255, 180, 180), Saturation = -1, Brightness = -0.5 }
    ):Play()
    task.wait(0.4)
    repeat RunService.RenderStepped:Wait() until status.Health.Value > 0
    TweenService:Create(deathFilter,
        TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
        { TintColor = Color3.fromRGB(255, 255, 255), Saturation = 0, Brightness = 0 }
    ):Play()
end

local function showDeathMessage(text)
    local label                    = Instance.new("TextLabel")
    label.Parent                   = interf
    label.Text                     = ""
    label.Size                     = UDim2.new(1, 0, 1, 0)
    label.Position                 = UDim2.new(0.5, 0, 0.5, 0)
    label.AnchorPoint              = Vector2.new(0.5, 0.5)
    label.BackgroundTransparency   = 1
    label.TextSize                 = 58
    label.TextStrokeTransparency   = 0.5
    label.TextColor3               = Color3.fromRGB(255, 255, 255)
    label.FontFace                 = Font.fromEnum(Enum.Font.Antique)
    for i = 1, #text do
        label.Text = string.sub(text, 1, i)
        task.wait(0.025)
    end
    task.wait(0.1)
    repeat RunService.RenderStepped:Wait() until status.Health.Value > 0
    TweenService:Create(label,
        TweenInfo.new(1.25, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
        { Size = UDim2.new(1.15, 0, 1.15, 0), TextTransparency = 1, TextStrokeTransparency = 1 }
    ):Play()
    Debris:AddItem(label, 1.25)
end

status.Health.Changed:Connect(function()
    if status.Health.Value <= 0 then
        task.wait()
        if not char:FindFirstChild("ImaDea") then return end

        local y0Lines = {
            "That all you got?",
            "Get back up. You are not done yet.",
            "The Dragon does not stay down.",
            "Shake it off. You have been through worse.",
            "Even the strongest fall sometimes. Get up.",
            "Is that really the best the Y0 style can do?",
            "You got dropped. Do not let it happen again.",
        }
        local yk1Lines = {
            "The Kiwami Dragon... not today.",
            "You have come too far to stop here.",
            "Get up. The Dragon of Dojima does not end like this.",
            "That hurt. Good. Remember it.",
            "A Kiwami fighter does not stay on the ground.",
            "You trained for this. Start showing it.",
            "Not your best. You know that.",
        }
        local pool   = Moveset == "YK1" and yk1Lines or y0Lines
        local chosen = pool[math.random(1, #pool)]

        local arena = status.MyArena.Value
        if arena and arena:FindFirstChild("AI")
            and arena.AI:FindFirstChild("Object")
            and arena.AI.Object.Value
            and arena.AI.Object.Value.Name == "Legendary Dragon"
        then
            chosen = "Only one Dragon stands at the top."
        end

        coroutine.wrap(showDeathMessage)(chosen)
        coroutine.wrap(playDeathFilter)()
    end
end)

