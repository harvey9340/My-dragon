-- Heat Gauge Logic
local function AddHeat(amount)
    HeatGauge = math.clamp(HeatGauge + amount, 0, MaxHeat)
    if HeatGauge >= MaxHeat and not DragonActive then
        DragonActive = true
        print("[DragonStyle] DRAGON MODE ACTIVATED!")
    end
end

local function ConsumeHeat(amount)
    if HeatGauge < amount then return false end
    HeatGauge = math.clamp(HeatGauge - amount, 0, MaxHeat)
    if HeatGauge <= 0 then
        DragonActive = false
        print("[DragonStyle] Dragon Mode ended.")
    end
    return true
end

-- Combo System
local function ExecuteCombo(hitIndex)
    local chain = ActiveMoveset.ComboChain
    local move  = chain[hitIndex]
    if not move then return end

    local now = tick()
    if (now - LastAttackTime) > 1.2 then
        CurrentCombo = 1
    else
        CurrentCombo = math.clamp(CurrentCombo + 1, 1, #chain)
    end
    LastAttackTime = now

    print(("[DragonStyle] %s | Hit %d | DMG: %d"):format(
        move.Name, CurrentCombo, move.Damage
    ))
    AddHeat(ActiveMoveset.HeatGainPerHit)

    if move.Stagger then
        print("[DragonStyle] Enemy staggered!")
    end
end

-- Charge Punch
local ChargeStart = nil
local function BeginCharge()
    ChargeStart = tick()
    print("[DragonStyle] Charging " .. ActiveMoveset.ChargePunch.Name .. "...")
end

local function ReleaseCharge()
    if not ChargeStart then return end
    local cp       = ActiveMoveset.ChargePunch
    local held     = tick() - ChargeStart
    local ratio    = math.clamp(held / cp.ChargeTime, 0, 1)
    local damage   = cp.MinDamage + ((cp.MaxDamage - cp.MinDamage) * ratio)
    ChargeStart    = nil

    if not ConsumeHeat(cp.HeatCost) then
        print("[DragonStyle] Not enough Heat for " .. cp.Name)
        return
    end

    print(("[DragonStyle] %s released! Charge: %.0f%% | DMG: %.0f"):format(
        cp.Name, ratio * 100, damage
    ))
    if cp.KnockBack then
        print("[DragonStyle] Enemy knocked back!")
    end
end

-- Tiger Drop Counter
local function AttemptTigerDrop()
    local td = ActiveMoveset.TigerDrop
    print(("[DragonStyle] %s window open (%.1fs)!"):format(td.Name, td.WindowTime))
    CounterReady = true

    task.delay(td.WindowTime, function()
        if CounterReady then
            CounterReady = false
            print("[DragonStyle] Counter window missed.")
        end
    end)
end

local function TriggerCounter()
    if not CounterReady then return end
    local td = ActiveMoveset.TigerDrop
    CounterReady = false
    AddHeat(td.HeatGain)
    print(("[DragonStyle] %s landed! DMG: %d | Heat +%d"):format(
        td.Name, td.Damage, td.HeatGain
    ))
    if td.KnockDown then
        print("[DragonStyle] Enemy knocked down!")
    end
end

-- Dragon Kick
local function UseDragonKick()
    local dk = ActiveMoveset.DragonKick
    if not ConsumeHeat(dk.HeatCost) then
        print("[DragonStyle] Not enough Heat for " .. dk.Name)
        return
    end

    print(("[DragonStyle] %s! DMG: %d"):format(dk.Name, dk.Damage))

    -- YK1 double hit
    if dk.DoubleHit then
        print(("[DragonStyle] %s hits twice! Total DMG: %d"):format(
            dk.Name, dk.Damage * 2
        ))
    end
    if dk.KnockDown then
        print("[DragonStyle] Enemy knocked down!")
    end
end

-- Dragon of Dojima (YK1 exclusive)
local function UseDragonOfDojima()
    if Moveset ~= "YK1" then return end
    local dod = ActiveMoveset.DragonOfDojima
    if not ConsumeHeat(dod.HeatCost) then
        print("[DragonStyle] Not enough Heat for " .. dod.Name)
        return
    end
    local total = dod.Damage * dod.Hits
    print(("[DragonStyle] %s! %d hits | Total DMG: %d"):format(
        dod.Name, dod.Hits, total
    ))
end

-- Heat Action
local function UseHeatAction(index)
    if not DragonActive then
        print("[DragonStyle] Dragon Mode required for Heat Actions.")
        return
    end
    local ha = ActiveMoveset.HeatActions[index]
    if not ha then return end
    if not ConsumeHeat(ha.HeatCost) then
        print("[DragonStyle] Not enough Heat for " .. ha.Name)
        return
    end
    print(("[DragonStyle] HEAT ACTION: %s | DMG: %d"):format(ha.Name, ha.Damage))
end

-- Heat Decay Loop
local lastHit = tick()
RunService.Heartbeat:Connect(function(dt)
    local idle = tick() - lastHit
    if idle > ActiveMoveset.HeatDecayDelay and HeatGauge > 0 then
        HeatGauge = math.max(0, HeatGauge - (ActiveMoveset.HeatDecayRate * dt))
        if HeatGauge <= 0 and DragonActive then
            DragonActive = false
            print("[DragonStyle] Dragon Mode ended (heat decayed).")
        end
    end
end)

