--[[
This is my own Dragon Style mod for Right 2 Fight.
Please use loadstring for this mod.

Put this above your loadstring before running.
_G.DragonConfigurations = {
  Moveset = "Y0", -- Y0 or YK1
  MorphMod = false, -- true or false
  VoiceMod = true, -- true or false
  CustomMorphSkin = false, -- true or false
  FeelTheHeat = true, -- true or false
  AuraSyncAddOn = true -- true or false
}
Y0 is the Yakuza 0 Dragon Style moveset.
YK1 is the Yakuza Kiwami 1 Dragon Style moveset.
CustomMorphSkin only works if MorphMod is set to true.
Enjoy the mod.
--]]

-- ══════════════════════════════════
--   CONFIG
-- ══════════════════════════════════

local Config          = _G.DragonConfigurations or {}
local Moveset         = Config.Moveset         or "Y0"
local MorphMod        = Config.MorphMod        or false
local VoiceMod        = Config.VoiceMod        or true
local CustomMorphSkin = Config.CustomMorphSkin or false
local FeelTheHeat     = Config.FeelTheHeat     or true
local AuraSyncAddOn   = Config.AuraSyncAddOn   or true

if CustomMorphSkin and not MorphMod then
    warn("CustomMorphSkin needs MorphMod = true. Turning it off.")
    CustomMorphSkin = false
end
if Moveset ~= "Y0" and Moveset ~= "YK1" then
    warn("Invalid moveset. Defaulting to Y0.")
    Moveset = "Y0"
end

-- ══════════════════════════════════
--   STYLE IDENTITY
--   Y0  = deep crimson red
--   YK1 = darker scarlet
-- ══════════════════════════════════

local StyleName = Moveset == "Y0" and "Dragon" or "Kiwami Dragon"
local StyleColor = Moveset == "Y0"
    and Color3.fromRGB(185, 10, 10)
    or  Color3.fromRGB(135, 0, 25)
local StyleSequence = ColorSequence.new({
    ColorSequenceKeypoint.new(0, StyleColor),
    ColorSequenceKeypoint.new(1, StyleColor)
})

-- ══════════════════════════════════
--   SERVICES
-- ══════════════════════════════════

