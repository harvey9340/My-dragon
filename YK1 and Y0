--   ONE TIME SETUP
-- ══════════════════════════════════

local function setupOnce()
    if hasSetup then return end
    hasSetup = true

    sendNotif("setting up " .. StyleName .. "...", StyleColor)

    StyleSequence = ColorSequence.new({
        ColorSequenceKeypoint.new(0, StyleColor),
        ColorSequenceKeypoint.new(1, StyleColor)
    })

    abil.Tabs.Tabs.Brawler.Filled.Title.Text = StyleName
    status.Stats.Kills_Brawler.Visual.Value  = "Enemies beaten in " .. StyleName .. " style"

    RPS.Styles.Brawler.Idle.AnimationId = "rbxassetid://12120045620"

    applyMoves()

    -- Heat shimmer at 50+ heat
    if not main.Heat:FindFirstChild("HeatShimmer") then
        local shimmer = main.Heat.Fill2:Clone()
        shimmer.Name              = "HeatShimmer"
        shimmer.Parent            = main.Heat
        shimmer.ImageColor3       = Color3.fromRGB(255, 255, 255)
        shimmer.ImageTransparency = 1
        shimmer.Visible           = false
        main.Heat.Fill2.Changed:Connect(function()
            shimmer.Size = main.Heat.Fill2.Size
        end)
        TweenService:Create(shimmer,
            TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, math.huge, true),
            { ImageTransparency = 0.4 }
        ):Play()
        coroutine.wrap(function()
            while true do
                RunService.RenderStepped:Wait()
                if char:FindFirstChild("Heated")
                    and not char.Heated:FindFirstChild("Throwing")
                    and char.Heated:FindFirstChild("Heating")
                    and char.Heated.Heating.Value ~= char
                then
                    shimmer.ImageColor3 = Color3.fromRGB(0, 200, 0)
                else
                    shimmer.ImageColor3 = Color3.fromRGB(255, 255, 255)
                end
            end
        end)()
        local function refreshShimmer()
            shimmer.Visible = status.Heat.Value >= 50
        end
        status.Heat.Changed:Connect(refreshShimmer)
        refreshShimmer()
    end

    -- Climax shimmer at 100 heat
    if not main.Heat:FindFirstChild("ClimaxShimmer") then
        local cs = main.Heat.ClimaxFill2:Clone()
        cs.Name              = "ClimaxShimmer"
        cs.Parent            = main.Heat
        cs.ImageColor3       = Color3.fromRGB(255, 255, 255)
        cs.ImageTransparency = 1
        cs.Visible           = false
        main.Heat.ClimaxFill2.Changed:Connect(function()
            cs.Size = main.Heat.ClimaxFill2.Size
        end)
        TweenService:Create(cs,
            TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, math.huge, true),
            { ImageTransparency = 0.4 }
        ):Play()
        coroutine.wrap(function()
            while true do
                RunService.RenderStepped:Wait()
                if char:FindFirstChild("Heated")
                    and not char.Heated:FindFirstChild("Throwing")
                    and char.Heated:FindFirstChild("Heating")
                    and char.Heated.Heating.Value ~= char
                then
                    cs.ImageColor3 = Color3.fromRGB(0, 200, 0)
                else
                    cs.ImageColor3 = Color3.fromRGB(255, 255, 255)
                end
            end
        end)()
        local function refreshClimax()
            cs.Visible = status.Heat.Value >= 100
        end
        status.Heat.Changed:Connect(refreshClimax)
        refreshClimax()
    end

    -- Stun particle for Komaki Parry targets
    if stunParticle == nil then
        stunParticle        = char.Head.FS:Clone()
        stunParticle.Rate   = 500
        stunParticle.Enabled = false
        stunParticle.Parent = RPS
        stunParticle.Name   = "DragonStunParticle"
    end

    if connections.StunParticle == nil then
        connections.StunParticle = char.ChildAdded:Connect(function(child)
            if status.Styles.Brawler:FindFirstChild("Ultimate Essence") then
                task.wait(0.1)
                if child.Name == "Heated" then
                    if child:FindFirstChild("MoveName") then
                        sessionHeatActions += 1
                        if sessionHeatActions % 10 == 0 then
                            sendNotif("heat actions this session: [" .. sessionHeatActions .. "]",
                                Color3.fromRGB(0, 200, 0))
                        end
                    end
                    if child:FindFirstChild("Throwing") and child:FindFirstChild("Heating") then
                        local target = child.Heating.Value
                        local t = 3
                        repeat task.wait(0.05) t -= 0.05
                        until target:FindFirstChild("Stunned") or not target or t <= 0
                        if target and target:FindFirstChild("Stunned")
                            and target.Stunned:FindFirstChild("Guru")
                        then
                            if not target.Head:FindFirstChild("DragonStunParticle") then
                                local p = stunParticle:Clone()
                                p.Parent  = target.Head
                                p.Color   = StyleSequence
                                p.Enabled = true
                                coroutine.wrap(function()
                                    while target:FindFirstChild("Stunned") do
                                        RunService.RenderStepped:Wait()
                                        p.Color = StyleSequence
                                    end
                                    p:Destroy()
                                end)()
                            end
                        end
                    end
                end
            end
        end)
    end

    -- Encounter title renames
    local function refreshTitle()
        local t = interf.BattleStart.Text
        if t == "LEGENDARY DRAGON" then
            interf.BattleStart.Text = "THE CRIMSON DRAGON"
        elseif t == "MYSTERIOUS MERCS" then
            interf.BattleStart.Text = "SUITS IN THE DARK"
        elseif t == "DELINQUENTS" then
            local r = math.random(1, 3)
            interf.BattleStart.Text = r == 1 and "STREET PUNKS" or r == 2 and "CORNER BOYS" or "DELINQUENTS"
        elseif t == "RICH FIEND" then
            interf.BattleStart.Text = "SILVER SPOON THUG"
        elseif t == "GORILLAMAN" then
            interf.BattleStart.Text = math.random(1, 2) == 1 and "THE BEAST" or "KNUCKLE DRAGGER"
        elseif t == "HUE" then
            interf.BattleStart.Text = "COPYCAT"
        elseif t == "BLOODSUCKER" then
            local r = math.random(1, 3)
            interf.BattleStart.Text = r == 1 and "THE NIGHT CRAWLER" or r == 2 and "SHADOW PUNK" or "BLOODSUCKER"
        end
    end
    if connections.BattleStart == nil then
        connections.BattleStart = interf.BattleStart.Changed:Connect(refreshTitle)
    end

    -- NPC dialogues
    if not isDungeon() then
        workspace.Map.MiniQuests["Helen"].Dialogue.Dialog.Value =
            [[I heard there's someone out there who fights like they've got nothing to lose. You remind me of them a little.]]
        workspace.Map.MiniQuests["Jort"].Dialogue.Dialog.Value =
            [[My buddy swears he saw someone take out five guys in under a minute near the docks. Said the guy didn't even break a sweat.]]
        workspace.Map.MiniQuests["Fisherman Jimbo"].Dialogue.Dialog.Value =
            [[You've got that look. Like you've been through it and came out the other side just fine.]]
        workspace.Map.MiniQuests["Fisherman Quill"].Dialogue.Dialog.Value =
            [[Rough waters today, kid. Some days you fight the tide, some days you ride it. Sounds like you already know which one you are.]]
        workspace.Map.MiniQuests["Anderson"].Dialogue.Dialog.Value =
            [[You solve everything with your fists and leave the paperwork to the rest of us.]]
    end

    menu.Bars.Mobile_Title.Text    = StyleName .. " Dragon Style Mod"
    menu.Bars.Mobile_Title.Visible = true

    -- Reload client to apply move swaps
    if not hasReloaded then
        hasReloaded = true
        local savedCF = char.LowerTorso.CFrame
        sendNotif("reloading to apply changes...", StyleColor)
        interf.Client.Disabled = true
        task.wait()
        interf.Client.Disabled = false
        task.wait(0.1)
        char.LowerTorso.CFrame = savedCF
    end
end

