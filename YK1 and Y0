UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    -- Q = Combo hit (press repeatedly)
    if input.KeyCode == Enum.KeyCode.Q then
        ExecuteCombo(CurrentCombo + 1)

    -- E (hold) = Charge Punch
    elseif input.KeyCode == Enum.KeyCode.E then
        BeginCharge()

    -- F = Tiger Drop window
    elseif input.KeyCode == Enum.KeyCode.F then
        AttemptTigerDrop()

    -- R = Dragon Kick
    elseif input.KeyCode == Enum.KeyCode.R then
        UseDragonKick()

    -- T = Dragon of Dojima (YK1 only)
    elseif input.KeyCode == Enum.KeyCode.T then
        UseDragonOfDojima()

    -- 1/2/3/4 = Heat Actions
    elseif input.KeyCode == Enum.KeyCode.One   then UseHeatAction(1)
    elseif input.KeyCode == Enum.KeyCode.Two   then UseHeatAction(2)
    elseif input.KeyCode == Enum.KeyCode.Three then UseHeatAction(3)
    elseif input.KeyCode == Enum.KeyCode.Four  then UseHeatAction(4)
    end
end)

UserInputService.InputEnded:Connect(function(input, processed)
    if processed then return end
    -- Release charge punch on E key up
    if input.KeyCode == Enum.KeyCode.E then
        ReleaseCharge()
    end
    -- Enemy hit during Tiger Drop window = counter lands
    if input.KeyCode == Enum.KeyCode.F then
        TriggerCounter()
    end
end)

