local function updateVisuals()
    if status.Style.Value ~= "Brawler" then
        char.UpperTorso["r2f_aura_burst"].Flare.Enabled  = false
        char.UpperTorso["r2f_aura_burst"].Lines1.Enabled = false
        if stance.IsPlaying then stance:Stop() end
        char.HumanoidRootPart.Fire_Main.Rate      = 80
        char.HumanoidRootPart.Fire_Secondary.Rate = 50
        char.HumanoidRootPart.Lines1.Rate         = 20
        char.HumanoidRootPart.Lines2.Rate         = 20
        main.Heat.Fill.ImageColor3        = Color3.fromRGB(40, 150, 250)
        main.Heat.Fill2.ImageColor3       = Color3.fromRGB(70, 250, 250)
        main.Heat.ClimaxFill.ImageColor3  = Color3.fromRGB(180, 0, 0)
        main.Heat.ClimaxFill2.ImageColor3 = Color3.fromRGB(250, 60, 100)
        return
    end

    -- Style name and XP bar
    RPS.Styles.Brawler.VisualName.Value = StyleName
    RPS.Styles.Brawler.Color.Value      = StyleColor
    main.XP.Fill.ImageColor3            = StyleColor

    -- Aura particles scale with heat
    local heat = status.Heat.Value
    char.HumanoidRootPart.Fire_Main.Color      = StyleSequence
    char.HumanoidRootPart.Fire_Secondary.Color = StyleSequence
    char.HumanoidRootPart.Lines1.Color         = StyleSequence
    char.HumanoidRootPart.Lines2.Color         = StyleSequence
    char.HumanoidRootPart.Sparks.Color         = StyleSequence
    char.HumanoidRootPart.Fire_Main.Rate      = heat >= 100 and 115 or heat >= 75 and 88 or 80
    char.HumanoidRootPart.Fire_Secondary.Rate = heat >= 100 and 92  or heat >= 75 and 80 or 70
    char.HumanoidRootPart.Lines1.Rate         = heat >= 100 and 60  or heat >= 75 and 40 or 20
    char.HumanoidRootPart.Lines2.Rate         = heat >= 100 and 60  or heat >= 75 and 40 or 20
    if not char.HumanoidRootPart.TimeFor.Enabled then
        char.HumanoidRootPart.TimeFor.Color = StyleSequence
