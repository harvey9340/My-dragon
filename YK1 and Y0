-- ══════════════════════════════════
--   NOTIFICATION HELPER
-- ══════════════════════════════════

local function sendNotif(text, color)
    color = color or Color3.new(1, 1, 1)
    local n = pgui:FindFirstChild("Notify")
    if n and n:IsA("BindableEvent") then n:Fire(text) end
end

-- ══════════════════════════════════
--   VALUE HELPER
-- ══════════════════════════════════

local function setValue(parent, name, value, class)
    if not parent or not name or value == nil then return end
    if not parent:FindFirstChild(name) then
        local v = Instance.new(class)
        v.Name   = name
        v.Parent = parent
    end
    parent[name].Value = value
end

-- ══════════════════════════════════
--   STATE CHECKS
-- ══════════════════════════════════

local function isInBattle()
    return plr:FindFirstChild("InBattle") ~= nil
end

local function isDungeon()
    return RPS.Dungeon.Value
end

local function doingHeatAction()
    return char:FindFirstChild("Heated") ~= nil
end

local function showAuraBurst()
    return isInBattle() and not doingHeatAction() and status.Heat.Value >= 100
end

